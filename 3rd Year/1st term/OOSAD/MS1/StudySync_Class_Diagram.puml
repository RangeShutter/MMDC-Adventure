  }

  class GroupMembership {
    -membershipId: int
    -role: MembershipRole
    -joinedAt: LocalDateTime
    -active: boolean
    .. Constructor ..
    +GroupMembership(membershipId: int, role: MembershipRole, joinedAt: LocalDateTime)
    .. Accessors ..
    +getMembershipId(): int
    +setMembershipId(membershipId: int): void
    +getRole(): MembershipRole
    +setRole(role: MembershipRole): void
    +getJoinedAt(): LocalDateTime
    +setJoinedAt(joinedAt: LocalDateTime): void
    +isActive(): boolean
    +setActive(active: boolean): void
    .. Operations ..
    +leaveGroup(): void
  }
}

package "Notification" {

  class Notification {
    -notificationId: int
    -type: NotificationType
    -message: String
    -read: boolean
    -createdAt: LocalDateTime
    .. Constructor ..
    +Notification(notificationId: int, type: NotificationType, message: String, createdAt: LocalDateTime)
    .. Accessors ..
    +getNotificationId(): int
    +setNotificationId(notificationId: int): void
    +getType(): NotificationType
    +setType(type: NotificationType): void
    +getMessage(): String
    +setMessage(message: String): void
