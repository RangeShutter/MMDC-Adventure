package "Enumerations" {

  enum AccountStatus <<enumeration>> {
    ACTIVE
    SUSPENDED
    DEACTIVATED
  }

  enum EmploymentStatus <<enumeration>> {
    FULL_TIME_STUDENT
    WORKING_STUDENT
  }

  enum WorkingStyle <<enumeration>> {
    INDEPENDENT
    FREQUENT_COLLABORATION
    STRUCTURED_MEETINGS
    FLEXIBLE
  }

  enum RecommendationStatus <<enumeration>> {
    NEW
    VIEWED
    DISMISSED
  }

  enum RequestStatus <<enumeration>> {
    PENDING
    ACCEPTED
    DECLINED
    CANCELLED
  }

  enum GroupStatus <<enumeration>> {
    FORMING
    COMPLETE
    DISBANDED
  }

  enum MembershipRole <<enumeration>> {
    LEADER
    MEMBER
  }

  enum NotificationType <<enumeration>> {
    MATCH_FOUND
    REQUEST_RECEIVED
    REQUEST_ACCEPTED
    REQUEST_DECLINED
    GROUP_INVITATION
    GROUP_UPDATE
  }

  enum ReportStatus <<enumeration>> {
    PENDING
    UNDER_REVIEW
    RESOLVED
    DISMISSED
  }
}

' ---------- Generalization ----------
User <|-- Student
User <|-- Administrator

' ---------- Composition ----------
Student "1" *-- "1" CollaborationProfile : owns >
CollaborationProfile "1" *-- "0..*" Availability : contains >
Student "1" *-- "0..*" Notification : receives >
ProjectGroup "1" *-- "1..*" GroupMembership : contains >

' ---------- Association classes ----------
Student "0..*" -- "0..*" Subject : enrolled in >
(Student, Subject) . SubjectEnrollment

Student "0..*" -- "0..*" ProjectGroup : member of >
(Student, ProjectGroup) . GroupMembership

' ---------- Associations ----------
Student "1" -- "0..*" MatchRecommendation : receives >
Subject "1" -- "0..*" MatchRecommendation : concerns >
GroupmateRequest "0..*" -- "1" Student : sender >
GroupmateRequest "0..*" -- "1" Student : receiver >
Subject "1" -- "0..*" GroupmateRequest : concerns >
Subject "1" -- "0..*" ProjectGroup : has >
UserReport "0..*" -- "1" Student : reporter >
UserReport "0..*" -- "1" User : reportedUser >
Administrator "0..1" -- "0..*" UserReport : reviews >

' ---------- Dependencies ----------
MatchingService ..> CollaborationProfile : <<use>> compares
MatchingService ..> SubjectEnrollment : <<use>> filters
MatchingService ..> MatchRecommendation : <<create>>
MatchRecommendation ..> GroupmateRequest : <<use>> initiates
Student ..> ProjectGroup : <<create>>
Student ..> GroupmateRequest : <<create>>
GroupmateRequest ..> Notification : <<create>> triggers
ProjectGroup ..> Notification : <<create>> triggers
Administrator ..> User : <<use>> manages
Administrator ..> Subject : <<use>> maintains

@enduml
