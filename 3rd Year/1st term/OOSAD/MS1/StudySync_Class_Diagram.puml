    .. Accessors ..
    +getMinimumScore(): double
    +setMinimumScore(minimumScore: double): void
    +getMaximumResults(): int
    +setMaximumResults(maximumResults: int): void
    .. Operations ..
    +findCandidates(studentId: int, subjectId: int): List<Student>
    +calculateCompatibility(studentId: int, candidateId: int): double
    +generateRecommendations(studentId: int, subjectId: int): List<MatchRecommendation>
  }

  class MatchRecommendation {
    -recommendationId: int
    -compatibilityScore: double
    -status: RecommendationStatus
    -createdAt: LocalDateTime
    .. Constructor ..
    +MatchRecommendation(recommendationId: int, compatibilityScore: double, createdAt: LocalDateTime)
    .. Accessors ..
