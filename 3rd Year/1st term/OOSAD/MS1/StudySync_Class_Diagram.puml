@startuml StudySync_Class_Diagram

title StudySync: MMDC Student Groupmate Matching System - Class Diagram

skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 70
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

package "Account and Access" {

  abstract class User {
    -userId: int
    -fullName: String
    -email: String
    -passwordHash: String
    -accountStatus: AccountStatus
    .. Constructor ..
    +User(userId: int, fullName: String, email: String, passwordHash: String)
    .. Accessors ..
    +getUserId(): int
    +setUserId(userId: int): void
    +getFullName(): String
    +setFullName(fullName: String): void
    +getEmail(): String
    +setEmail(email: String): void
    +getPasswordHash(): String
    +setPasswordHash(passwordHash: String): void
    +getAccountStatus(): AccountStatus
    +setAccountStatus(accountStatus: AccountStatus): void
    .. Operations ..
    +login(email: String, password: String): boolean
    +logout(): void
    +updateBasicInfo(fullName: String, email: String): void
    +{abstract} getRole(): String
  }

  class Student {
    -studentNumber: String
    .. Constructor ..
    +Student(userId: int, fullName: String, email: String, passwordHash: String, studentNumber: String)
    .. Accessors ..
    +getStudentNumber(): String
    +setStudentNumber(studentNumber: String): void
    .. Operations ..
    +getRole(): String
    +viewPotentialGroupmates(subjectId: int): List<MatchRecommendation>
    +sendGroupmateRequest(receiverId: int, subjectId: int): GroupmateRequest
    +respondToRequest(requestId: int, accept: boolean): void
    +createProjectGroup(subjectId: int, groupName: String): ProjectGroup
    +submitReport(reportedUserId: int, reason: String): UserReport
  }

  class Administrator {
    -adminCode: String
    .. Constructor ..
    +Administrator(userId: int, fullName: String, email: String, passwordHash: String, adminCode: String)
    .. Accessors ..
    +getAdminCode(): String
    +setAdminCode(adminCode: String): void
    .. Operations ..
    +getRole(): String
    +manageUser(userId: int, action: String): void
    +manageSubject(subjectId: int, action: String): void
    +reviewReport(reportId: int, resolution: String): void
  }

  class UserReport {
    -reportId: int
    -reason: String
    -details: String
    -status: ReportStatus
    -submittedAt: LocalDateTime
    -resolution: String
    .. Constructor ..
    +UserReport(reportId: int, reason: String, details: String, submittedAt: LocalDateTime)
    .. Accessors ..
    +getReportId(): int
    +setReportId(reportId: int): void
    +getReason(): String
    +setReason(reason: String): void
    +getDetails(): String
    +setDetails(details: String): void
    +getStatus(): ReportStatus
    +setStatus(status: ReportStatus): void
    +getSubmittedAt(): LocalDateTime
    +setSubmittedAt(submittedAt: LocalDateTime): void
    +getResolution(): String
    +setResolution(resolution: String): void
    .. Operations ..
    +resolve(resolution: String): void
  }
}

package "Profile and Enrollment" {

  class CollaborationProfile {
    -profileId: int
    -itMajor: String
    -employmentStatus: EmploymentStatus
    -workSchedule: String
    -workingStyle: WorkingStyle
    -profileSummary: String
    -lastUpdated: LocalDateTime
    .. Constructor ..
    +CollaborationProfile(profileId: int, itMajor: String, employmentStatus: EmploymentStatus, workingStyle: WorkingStyle)
    .. Accessors ..
    +getProfileId(): int
    +setProfileId(profileId: int): void
    +getItMajor(): String
    +setItMajor(itMajor: String): void
    +getEmploymentStatus(): EmploymentStatus
    +setEmploymentStatus(employmentStatus: EmploymentStatus): void
    +getWorkSchedule(): String
    +setWorkSchedule(workSchedule: String): void
    +getWorkingStyle(): WorkingStyle
    +setWorkingStyle(workingStyle: WorkingStyle): void
    +getProfileSummary(): String
    +setProfileSummary(profileSummary: String): void
    +getLastUpdated(): LocalDateTime
    +setLastUpdated(lastUpdated: LocalDateTime): void
    .. Operations ..
    +updateProfile(itMajor: String, employmentStatus: EmploymentStatus, workSchedule: String, workingStyle: WorkingStyle): void
    +addAvailability(availability: Availability): void
    +removeAvailability(availabilityId: int): void
  }

  class Availability {
    -availabilityId: int
    -dayOfWeek: String
    -startTime: LocalTime
    -endTime: LocalTime
    -recurring: boolean
    .. Constructor ..
    +Availability(availabilityId: int, dayOfWeek: String, startTime: LocalTime, endTime: LocalTime, recurring: boolean)
    .. Accessors ..
    +getAvailabilityId(): int
    +setAvailabilityId(availabilityId: int): void
    +getDayOfWeek(): String
    +setDayOfWeek(dayOfWeek: String): void
    +getStartTime(): LocalTime
    +setStartTime(startTime: LocalTime): void
    +getEndTime(): LocalTime
    +setEndTime(endTime: LocalTime): void
    +isRecurring(): boolean
    +setRecurring(recurring: boolean): void
    .. Operations ..
    +overlaps(other: Availability): boolean
    +getDurationInHours(): double
  }

  class Subject {
    -subjectId: int
    -subjectCode: String
    -subjectName: String
    -term: String
    -active: boolean
    .. Constructor ..
    +Subject(subjectId: int, subjectCode: String, subjectName: String, term: String)
    .. Accessors ..
    +getSubjectId(): int
    +setSubjectId(subjectId: int): void
    +getSubjectCode(): String
    +setSubjectCode(subjectCode: String): void
    +getSubjectName(): String
    +setSubjectName(subjectName: String): void
    +getTerm(): String
    +setTerm(term: String): void
    +isActive(): boolean
    +setActive(active: boolean): void
    .. Operations ..
    +updateDetails(subjectCode: String, subjectName: String, term: String): void
  }

  class SubjectEnrollment {
    -enrollmentId: int
    -lookingForGroup: boolean
    -enrolledAt: LocalDate
    .. Constructor ..
    +SubjectEnrollment(enrollmentId: int, lookingForGroup: boolean, enrolledAt: LocalDate)
    .. Accessors ..
    +getEnrollmentId(): int
    +setEnrollmentId(enrollmentId: int): void
    +isLookingForGroup(): boolean
    +setLookingForGroup(lookingForGroup: boolean): void
    +getEnrolledAt(): LocalDate
    +setEnrolledAt(enrolledAt: LocalDate): void
  }
}

