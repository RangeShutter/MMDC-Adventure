    +setRespondedAt(respondedAt: LocalDateTime): void
    .. Operations ..
    +accept(): void
    +decline(): void
    +cancel(): void
  }

  class ProjectGroup {
    -groupId: int
    -groupName: String
    -maximumMembers: int
    -createdAt: LocalDateTime
    -status: GroupStatus
    .. Constructor ..
    +ProjectGroup(groupId: int, groupName: String, maximumMembers: int, createdAt: LocalDateTime)
    .. Accessors ..
    +getGroupId(): int
    +setGroupId(groupId: int): void
    +getGroupName(): String
    +setGroupName(groupName: String): void
    +getMaximumMembers(): int
    +setMaximumMembers(maximumMembers: int): void
    +getCreatedAt(): LocalDateTime
    +setCreatedAt(createdAt: LocalDateTime): void
    +getStatus(): GroupStatus
    +setStatus(status: GroupStatus): void
    .. Operations ..
    +addMember(studentId: int): void
    +removeMember(studentId: int): void
