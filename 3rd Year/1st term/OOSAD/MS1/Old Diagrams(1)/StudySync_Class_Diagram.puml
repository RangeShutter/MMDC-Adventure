@startuml StudySync_Class_Diagram

title StudySync: MMDC Student Groupmate Matching System - Class Diagram

skinparam classAttributeIconSize 0
hide circle
hide empty members
skinparam nodesep 60
skinparam ranksep 70
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

package "Account and Access" {

  abstract class "User\n{abstract}" as User {
    -userId: int
    -fullName: String
    -email: String
    -passwordHash: String
    -accountStatus: AccountStatus = ACTIVE
    {method} «create» +User(userId: int, fullName: String, email: String, passwordHash: String)
    +getUserId(): int
    +setUserId(userId: int): void
    +getFullName(): String
    +setFullName(fullName: String): void
    +getEmail(): String
    +setEmail(email: String): void
    +getPasswordHash(): String
    +setPasswordHash(passwordHash: String): void
    +getAccountStatus(): AccountStatus
    +setAccountStatus(accountStatus: AccountStatus): void
    +login(email: String, password: String): boolean
    +logout(): void
    +updateBasicInfo(fullName: String, email: String): void
    +{abstract} getRole(): String
  }

  class Student {
    -studentNumber: String
    {method} «create» +Student(userId: int, fullName: String, email: String, passwordHash: String, studentNumber: String)
    +getStudentNumber(): String
    +setStudentNumber(studentNumber: String): void
    +getRole(): String
    +viewPotentialGroupmates(subjectId: int): MatchRecommendation[0..*]
    +sendGroupmateRequest(receiverId: int, subjectId: int): GroupmateRequest
    +respondToRequest(requestId: int, accept: boolean): void
    +createProjectGroup(subjectId: int, groupName: String): ProjectGroup
    +submitReport(reportedUserId: int, reason: String): UserReport
  }

  class Administrator {
    -adminCode: String
    {method} «create» +Administrator(userId: int, fullName: String, email: String, passwordHash: String, adminCode: String)
    +getAdminCode(): String
    +setAdminCode(adminCode: String): void
    +getRole(): String
    +manageUser(userId: int, action: String): void
    +manageSubject(subjectId: int, action: String): void
    +reviewReport(reportId: int, resolution: String): void
  }

  class UserReport {
    -reportId: int
    -reason: String
    -details: String
    -status: ReportStatus = PENDING
    -submittedAt: LocalDateTime
    -resolution: String
    {method} «create» +UserReport(reportId: int, reason: String, details: String, submittedAt: LocalDateTime)
    +getReportId(): int
    +setReportId(reportId: int): void
    +getReason(): String
    +setReason(reason: String): void
    +getDetails(): String
    +setDetails(details: String): void
    +getStatus(): ReportStatus
    +setStatus(status: ReportStatus): void
    +getSubmittedAt(): LocalDateTime
    +setSubmittedAt(submittedAt: LocalDateTime): void
    +getResolution(): String
    +setResolution(resolution: String): void
    +resolve(resolution: String): void
  }
}

package "Profile and Enrollment" {

  class CollaborationProfile {
    -profileId: int
    -itMajor: String
    -employmentStatus: EmploymentStatus
    -workSchedule: String
    -workingStyle: WorkingStyle
    -profileSummary: String
    -lastUpdated: LocalDateTime
    {method} «create» +CollaborationProfile(profileId: int, itMajor: String, employmentStatus: EmploymentStatus, workingStyle: WorkingStyle)
    +getProfileId(): int
    +setProfileId(profileId: int): void
    +getItMajor(): String
    +setItMajor(itMajor: String): void
    +getEmploymentStatus(): EmploymentStatus
    +setEmploymentStatus(employmentStatus: EmploymentStatus): void
    +getWorkSchedule(): String
    +setWorkSchedule(workSchedule: String): void
    +getWorkingStyle(): WorkingStyle
    +setWorkingStyle(workingStyle: WorkingStyle): void
    +getProfileSummary(): String
    +setProfileSummary(profileSummary: String): void
    +getLastUpdated(): LocalDateTime
    +setLastUpdated(lastUpdated: LocalDateTime): void
    +updateProfile(itMajor: String, employmentStatus: EmploymentStatus, workSchedule: String, workingStyle: WorkingStyle): void
    +addAvailability(availability: Availability): void
    +removeAvailability(availabilityId: int): void
  }

  class Availability {
    -availabilityId: int
    -dayOfWeek: String
    -startTime: LocalTime
    -endTime: LocalTime
    -recurring: boolean = true
    {method} «create» +Availability(availabilityId: int, dayOfWeek: String, startTime: LocalTime, endTime: LocalTime, recurring: boolean)
    +getAvailabilityId(): int
    +setAvailabilityId(availabilityId: int): void
    +getDayOfWeek(): String
    +setDayOfWeek(dayOfWeek: String): void
    +getStartTime(): LocalTime
    +setStartTime(startTime: LocalTime): void
    +getEndTime(): LocalTime
    +setEndTime(endTime: LocalTime): void
    +isRecurring(): boolean
    +setRecurring(recurring: boolean): void
    +overlaps(other: Availability): boolean
    +getDurationInHours(): double
  }

  class Subject {
    -subjectId: int
    -subjectCode: String
    -subjectName: String
    -term: String
    -active: boolean = true
    {method} «create» +Subject(subjectId: int, subjectCode: String, subjectName: String, term: String)
    +getSubjectId(): int
    +setSubjectId(subjectId: int): void
    +getSubjectCode(): String
    +setSubjectCode(subjectCode: String): void
    +getSubjectName(): String
    +setSubjectName(subjectName: String): void
    +getTerm(): String
    +setTerm(term: String): void
    +isActive(): boolean
    +setActive(active: boolean): void
    +updateDetails(subjectCode: String, subjectName: String, term: String): void
  }

  class SubjectEnrollment {
    -enrollmentId: int
    -lookingForGroup: boolean = true
    -enrolledAt: LocalDate
    {method} «create» +SubjectEnrollment(enrollmentId: int, lookingForGroup: boolean, enrolledAt: LocalDate)
    +getEnrollmentId(): int
    +setEnrollmentId(enrollmentId: int): void
    +isLookingForGroup(): boolean
    +setLookingForGroup(lookingForGroup: boolean): void
    +getEnrolledAt(): LocalDate
    +setEnrolledAt(enrolledAt: LocalDate): void
  }
}

package "Matching and Collaboration" {

  class MatchingService {
    -minimumScore: double
    -maximumResults: int
    {method} «create» +MatchingService(minimumScore: double, maximumResults: int)
    +getMinimumScore(): double
    +setMinimumScore(minimumScore: double): void
    +getMaximumResults(): int
    +setMaximumResults(maximumResults: int): void
    +findCandidates(studentId: int, subjectId: int): Student[0..*]
    +calculateCompatibility(studentId: int, candidateId: int): double
    +generateRecommendations(studentId: int, subjectId: int): MatchRecommendation[0..*]
  }

  class MatchRecommendation {
    -recommendationId: int
    -compatibilityScore: double
    -status: RecommendationStatus = NEW
    -createdAt: LocalDateTime
    {method} «create» +MatchRecommendation(recommendationId: int, compatibilityScore: double, createdAt: LocalDateTime)
    +getRecommendationId(): int
    +setRecommendationId(recommendationId: int): void
    +getCompatibilityScore(): double
    +setCompatibilityScore(compatibilityScore: double): void
    +getStatus(): RecommendationStatus
    +setStatus(status: RecommendationStatus): void
    +getCreatedAt(): LocalDateTime
    +setCreatedAt(createdAt: LocalDateTime): void
    +markViewed(): void
    +dismiss(): void
  }

  class GroupmateRequest {
    -requestId: int
    -status: RequestStatus = PENDING
    -message: String
    -sentAt: LocalDateTime
    -respondedAt: LocalDateTime
    {method} «create» +GroupmateRequest(requestId: int, message: String, sentAt: LocalDateTime)
    +getRequestId(): int
    +setRequestId(requestId: int): void
    +getStatus(): RequestStatus
    +setStatus(status: RequestStatus): void
    +getMessage(): String
    +setMessage(message: String): void
    +getSentAt(): LocalDateTime
    +setSentAt(sentAt: LocalDateTime): void
    +getRespondedAt(): LocalDateTime
    +setRespondedAt(respondedAt: LocalDateTime): void
    +accept(): void
    +decline(): void
    +cancel(): void
  }

  class ProjectGroup {
    -groupId: int
    -groupName: String
    -maximumMembers: int
    -createdAt: LocalDateTime
    -status: GroupStatus = FORMING
    {method} «create» +ProjectGroup(groupId: int, groupName: String, maximumMembers: int, createdAt: LocalDateTime)
    +getGroupId(): int
    +setGroupId(groupId: int): void
    +getGroupName(): String
    +setGroupName(groupName: String): void
    +getMaximumMembers(): int
    +setMaximumMembers(maximumMembers: int): void
    +getCreatedAt(): LocalDateTime
    +setCreatedAt(createdAt: LocalDateTime): void
    +getStatus(): GroupStatus
    +setStatus(status: GroupStatus): void
    +addMember(studentId: int): void
    +removeMember(studentId: int): void
    +viewMembers(): GroupMembership[1..*]
    +isFull(): boolean
  }

  class GroupMembership {
    -membershipId: int
    -role: MembershipRole = MEMBER
    -joinedAt: LocalDateTime
    -active: boolean = true
    {method} «create» +GroupMembership(membershipId: int, role: MembershipRole, joinedAt: LocalDateTime)
    +getMembershipId(): int
    +setMembershipId(membershipId: int): void
    +getRole(): MembershipRole
    +setRole(role: MembershipRole): void
    +getJoinedAt(): LocalDateTime
    +setJoinedAt(joinedAt: LocalDateTime): void
    +isActive(): boolean
    +setActive(active: boolean): void
    +leaveGroup(): void
  }
}

package "Notification" {

  class Notification {
    -notificationId: int
    -type: NotificationType
    -message: String
    -read: boolean = false
    -createdAt: LocalDateTime
    {method} «create» +Notification(notificationId: int, type: NotificationType, message: String, createdAt: LocalDateTime)
    +getNotificationId(): int
    +setNotificationId(notificationId: int): void
    +getType(): NotificationType
    +setType(type: NotificationType): void
    +getMessage(): String
    +setMessage(message: String): void
    +isRead(): boolean
    +setRead(read: boolean): void
    +getCreatedAt(): LocalDateTime
    +setCreatedAt(createdAt: LocalDateTime): void
    +markAsRead(): void
  }
}

package "Enumerations" {

  enum AccountStatus <<enumeration>> {
    ACTIVE
    SUSPENDED
    DEACTIVATED
  }

  enum EmploymentStatus <<enumeration>> {
    FULL_TIME_STUDENT
    WORKING_STUDENT
  }

  enum WorkingStyle <<enumeration>> {
    INDEPENDENT
    FREQUENT_COLLABORATION
    STRUCTURED_MEETINGS
    FLEXIBLE
  }

  enum RecommendationStatus <<enumeration>> {
    NEW
    VIEWED
    DISMISSED
  }

  enum RequestStatus <<enumeration>> {
    PENDING
    ACCEPTED
    DECLINED
    CANCELLED
  }

  enum GroupStatus <<enumeration>> {
    FORMING
    COMPLETE
    DISBANDED
  }

  enum MembershipRole <<enumeration>> {
    LEADER
    MEMBER
  }

  enum NotificationType <<enumeration>> {
    MATCH_FOUND
    REQUEST_RECEIVED
    REQUEST_ACCEPTED
    REQUEST_DECLINED
    GROUP_INVITATION
    GROUP_UPDATE
  }

  enum ReportStatus <<enumeration>> {
    PENDING
    UNDER_REVIEW
    RESOLVED
    DISMISSED
  }
}

' ---------- Generalization ----------
User <|-- Student
User <|-- Administrator

' ---------- Composition ----------
Student "1" *-- "1" CollaborationProfile
CollaborationProfile "1" *-- "0..*" Availability
Student "1" *--> "0..*" Notification

' ---------- Association classes ----------
Student "0..*" -- "0..*" Subject
(Student, Subject) .. SubjectEnrollment

Student "member\n1..*" -- "0..*" ProjectGroup
note on link : {members <= maximumMembers}
(Student, ProjectGroup) .. GroupMembership

' ---------- Associations (role names at the ends) ----------
Student "recipient\n1" -- "0..*" MatchRecommendation
Student "candidate\n1" -- "0..*" MatchRecommendation
Subject "1" -- "0..*" MatchRecommendation
Student "sender\n1" -- "0..*" GroupmateRequest
Student "receiver\n1" -- "0..*" GroupmateRequest
Subject "1" -- "0..*" GroupmateRequest
Subject "1" -- "0..*" ProjectGroup
Student "reporter\n1" -- "0..*" UserReport
User "reportedUser\n1" -- "0..*" UserReport
Administrator "reviewer\n0..1" -- "0..*" UserReport

' ---------- Dependencies (one stereotype each) ----------
MatchingService ..> MatchRecommendation : <<create>>
MatchingService ..> CollaborationProfile : <<use>>
MatchingService ..> SubjectEnrollment : <<use>>
Administrator ..> Subject : <<use>>

@enduml
