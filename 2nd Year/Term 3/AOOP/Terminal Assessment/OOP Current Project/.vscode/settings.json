{
    "java.import.eclipse.enabled": true,
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": false,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.project.sourcePaths": [
        "GEAR.HR/src",
        "GEAR.HR/test"
    ],
    "java.project.outputPath": "GEAR.HR/bin",
    "java.project.referencedLibraries": [
        "GEAR.HR/lib/mysql-connector-j-9.7.0.jar",
        "GEAR.HR/lib/junit-4.13.2.jar",
        "GEAR.HR/lib/hamcrest-core-1.3.jar",
        "GEAR.HR/lib/jasperreports-6.17.0.jar",
        "GEAR.HR/lib/commons-beanutils-1.9.4.jar",
        "GEAR.HR/lib/commons-collections-3.2.2.jar",
        "GEAR.HR/lib/commons-collections4-4.4.jar",
        "GEAR.HR/lib/commons-digester-2.1.jar",
        "GEAR.HR/lib/commons-logging-1.2.jar",
        "GEAR.HR/lib/commons-lang3-3.12.0.jar",
        "GEAR.HR/lib/ecj-3.21.0.jar",
        "GEAR.HR/lib/itext-2.1.7.js2.jar"
    ],
    "sqltools.connections": [
        {
            "mysqlOptions": {
                "authProtocol": "default",
                "enableSsl": "Disabled"
            },
            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "localhost",
            "port": 3306,
            "driver": "MySQL",
            "name": "gear.hr",
            "database": "gear.hr",
            "username": "root"
        }
    ]
}
