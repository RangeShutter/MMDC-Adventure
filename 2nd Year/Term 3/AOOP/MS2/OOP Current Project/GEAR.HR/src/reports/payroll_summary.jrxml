<?xml version="1.0" encoding="UTF-8"?>
<!-- GEAR.HR department payroll summary report (JasperReports). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payroll_summary" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" language="java">

    <parameter name="REPORT_MONTH" class="java.lang.String"/>
    <parameter name="REPORT_DEPARTMENT" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>

    <field name="employeeId" class="java.lang.String"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="position" class="java.lang.String"/>
    <field name="workedHours" class="java.lang.Double"/>
    <field name="grossPay" class="java.lang.Double"/>
    <field name="totalDeductions" class="java.lang.Double"/>
    <field name="totalAllowances" class="java.lang.Double"/>
    <field name="netSalary" class="java.lang.Double"/>

    <variable name="sumGross" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{grossPay}]]></variableExpression>
    </variable>
    <variable name="sumDeductions" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{totalDeductions}]]></variableExpression>
    </variable>
    <variable name="sumAllowances" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAllowances}]]></variableExpression>
    </variable>
    <variable name="sumNet" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{netSalary}]]></variableExpression>
    </variable>
    <variable name="employeeCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{employeeId}]]></variableExpression>
    </variable>

    <title>
        <band height="90">
            <staticText>
                <reportElement x="0" y="0" width="555" height="28"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[GEAR.HR Payroll Summary]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="34" width="555" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Department: " + ($P{REPORT_DEPARTMENT} == null ? "All Departments" : $P{REPORT_DEPARTMENT})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="54" width="555" height="16"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Month: " + ($P{REPORT_MONTH} == null ? "" : $P{REPORT_MONTH})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="555" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + ($P{GENERATED_AT} == null ? "" : $P{GENERATED_AT})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement x="0" y="0" width="45" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[ ID]]></text></staticText>
            <staticText><reportElement x="45" y="0" width="95" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[ Name]]></text></staticText>
            <staticText><reportElement x="140" y="0" width="110" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[ Position]]></text></staticText>
            <staticText><reportElement x="250" y="0" width="55" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Hours ]]></text></staticText>
            <staticText><reportElement x="305" y="0" width="60" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Gross ]]></text></staticText>
            <staticText><reportElement x="365" y="0" width="60" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Deduct ]]></text></staticText>
            <staticText><reportElement x="425" y="0" width="60" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Allow ]]></text></staticText>
            <staticText><reportElement x="485" y="0" width="70" height="20" mode="Opaque" backcolor="#E6E6E6"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Net ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="45" height="16"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{employeeId}]]></textFieldExpression></textField>
            <textField><reportElement x="45" y="0" width="95" height="16"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression></textField>
            <textField><reportElement x="140" y="0" width="110" height="16"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{position}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="250" y="0" width="55" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{workedHours}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="305" y="0" width="60" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{grossPay}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="365" y="0" width="60" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{totalDeductions}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="425" y="0" width="60" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{totalAllowances}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="485" y="0" width="70" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{netSalary}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="60">
            <line><reportElement x="0" y="2" width="555" height="1"/></line>
            <staticText><reportElement x="0" y="8" width="250" height="16"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[DEPARTMENT TOTALS]]></text></staticText>
            <textField><reportElement x="0" y="26" width="250" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Employees: " + $V{employeeCount}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="305" y="8" width="60" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{sumGross}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="365" y="8" width="60" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{sumDeductions}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="425" y="8" width="60" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{sumAllowances}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="485" y="8" width="70" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{sumNet}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
